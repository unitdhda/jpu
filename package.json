{
  "name": "jpu-monorepo",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "test": "node --test packages/core/test/*.test.js && PYTHONPATH=packages/training python3 -m unittest discover -s packages/training/test",
    "test:core": "node --test packages/core/test/*.test.js",
    "test:training": "PYTHONPATH=packages/training python3 -m unittest discover -s packages/training/test",
    "benchmark:teachers": "PYTHONPATH=packages/training:. python3 -m packages.benchmark.benchmark_teachers",
    "build:website": "corepack pnpm --filter @jpu/website build",
    "website:dev": "corepack pnpm --filter @jpu/website dev"
  }
}
