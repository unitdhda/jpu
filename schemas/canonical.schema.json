{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jpu://schemas/canonical.phase1.v1",
  "title": "JPU canonical Phase 1 record",
  "type": "object",
  "required": ["schema_version", "text", "source", "document_id", "boundaries", "spans", "b_spans", "bunsetsu"],
  "properties": {
    "schema_version": {"const": "jpu.phase1.v1"},
    "text": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "boundaries": {
      "type": "object",
      "required": ["a", "b", "bunsetsu", "clause", "sentence"],
      "additionalProperties": false,
      "properties": {
        "a": {"$ref": "#/$defs/endpoints"},
        "b": {"$ref": "#/$defs/endpoints"},
        "bunsetsu": {"$ref": "#/$defs/endpoints"},
        "clause": {"$ref": "#/$defs/endpoints"},
        "sentence": {"$ref": "#/$defs/endpoints"}
      }
    },
    "spans": {"type": "array", "items": {"$ref": "#/$defs/atom"}},
    "b_spans": {"type": "array", "items": {"$ref": "#/$defs/span"}},
    "bunsetsu": {"type": "array", "items": {"$ref": "#/$defs/bunsetsu"}},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "endpoints": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "span": {
      "type": "object", "required": ["start", "end"],
      "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}},
      "additionalProperties": true
    },
    "atom": {
      "allOf": [{"$ref": "#/$defs/span"}],
      "required": ["start", "end", "atom_type", "function", "inflections"]
    },
    "bunsetsu": {
      "allOf": [{"$ref": "#/$defs/span"}],
      "required": ["start", "end", "role"]
    }
  }
}
